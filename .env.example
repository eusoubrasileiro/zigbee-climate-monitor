# Copy to .env and edit. .env is ignored by git.

# Stable path to your Zigbee stick. List candidates with: ls -l /dev/serial/by-id/
ZIGBEE_SERIAL_PORT=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0

# MQTT topic of the sensor to record. The address appears in the Zigbee2MQTT
# log and web UI once the sensor has paired.
SENSOR_TOPIC=zigbee2mqtt/0x0000000000000000

# Name shown at the top of the page.
SENSOR_NAME=Living room

# Your timezone, used for Zigbee2MQTT log timestamps.
TZ=UTC
